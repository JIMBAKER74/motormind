# Copy to firebase.env (ignored by git) and build with:
#   flutter run --dart-define-from-file=firebase.env
# Leave this file absent and the app runs with analytics as a no-op.
# These values identify a Firebase project; they are not secrets (see README),
# but they are kept out of the repository so a fork reports to its own project.
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
